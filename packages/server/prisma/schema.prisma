generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- better-auth tables ----------
// Schemas chosen to match better-auth's default Prisma adapter.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  plan          String   @default("free")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  decks              Deck[]
  subjects           Subject[]
  tags               Tag[]
  importProcesses    ImportProcess[]
  spreadsheetImports SpreadsheetImport[]
  books              Book[]
}

enum TagOwnerType {
  SYSTEM
  USER
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------- domain ----------

model Language {
  id                      Int     @id @default(autoincrement())
  name                    String  @unique
  englishName             String?
  emoji                   String
  speechRecognitionLocale String?

  decksAsDefaultFront           Deck[]          @relation("DeckDefaultFrontLanguage")
  decksAsDefaultBack            Deck[]          @relation("DeckDefaultBackLanguage")
  importProcessesAsDefaultFront ImportProcess[] @relation("ImportProcessDefaultFrontLanguage")
  importProcessesAsDefaultBack  ImportProcess[] @relation("ImportProcessDefaultBackLanguage")
  booksAsSource                 Book[]          @relation("BookSourceLanguage")
  booksAsTarget                 Book[]          @relation("BookTargetLanguage")
}

// Home listing rows are Decks. A book is a Deck with kind = BOOK plus a Book
// satellite row; that keeps ordering, search, paging and drag-and-drop shared,
// while every book-specific field and screen stays in the Books domain.
enum LibraryItemKind {
  DECK
  BOOK
}

model Deck {
  id                       String                 @id @default(cuid())
  name                     String
  kind                     LibraryItemKind        @default(DECK)
  userId                   String
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultFrontLanguageId   Int?
  defaultFrontLanguage     Language?              @relation("DeckDefaultFrontLanguage", fields: [defaultFrontLanguageId], references: [id], onDelete: SetNull)
  defaultBackLanguageId    Int?
  defaultBackLanguage      Language?              @relation("DeckDefaultBackLanguage", fields: [defaultBackLanguageId], references: [id], onDelete: SetNull)
  speechRecognitionEnabled Boolean                @default(true)
  inverseReviewEnabled     Boolean                @default(false)
  inverseReviewStreak      Int                    @default(0)
  sequentialEnabled        Boolean                @default(false)
  completionScore          Float?
  completionComputedAt     DateTime?
  subjects                 Subject[]
  cards                    Card[]
  reviewStats              ReviewStat[]
  createdAt                DateTime               @default(now())
  sortOrder                Float                  @default(0)
  reviewStatUniqueCards    ReviewStatUniqueCard[]
  spreadsheetImports       SpreadsheetImport[]
  book                     Book?

  @@unique([userId, name])
}

model Subject {
  id              String    @id @default(cuid())
  deckId          String
  deck            Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  subject         String
  subjectKey      String
  randomKey       Int       @default(0)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstSeenAt     DateTime?
  lastSeenAt      DateTime?
  lastSeenShuffle DateTime?
  timesSeen       Int       @default(0)
  fixationLevel   String    @default("1")
  order           Int?
  inverseReviewed Boolean   @default(false)
  cooldownAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  cards           Card[]

  @@unique([deckId, subjectKey])
  @@index([deckId, randomKey])
  @@index([deckId, cooldownAt, randomKey])
  @@index([deckId, lastSeenShuffle])
  @@index([userId, lastSeenShuffle])
  @@index([userId, deckId])
}

model Card {
  id                    String                 @id @default(cuid())
  deckId                String
  deck                  Deck                   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  subjectId             String
  subject               Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  front                 String
  frontHash             String
  back                  String
  genTemplate           String?
  lastSeenAt            DateTime?
  timesSeen             Int                    @default(0)
  order                 Int?
  createdAt             DateTime               @default(now())
  cardTags              CardTag[]
  reviewStatUniqueCards ReviewStatUniqueCard[]

  @@unique([subjectId, frontHash])
  @@index([subjectId, lastSeenAt])
  @@index([deckId])
}

model Tag {
  id        String       @id @default(cuid())
  ownerType TagOwnerType
  ownerKey  String
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  cardTags  CardTag[]

  @@unique([ownerKey, name])
  @@index([ownerKey])
  @@index([userId])
}

model CardTag {
  cardId String
  tagId  String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@index([tagId])
}

enum ImportProcessStatus {
  UPLOADED
  ANALYZING
  AWAITING_CONFIGURATION
  VALIDATING
  IMPORTING
  SUCCEEDED
  FAILED
}

enum ImportCardTypeKind {
  BASIC
  CLOZE
}

enum WorkerJobType {
  ANALYZE_ANKI_IMPORT
  RUN_ANKI_IMPORT
  RUN_DECK_SPREADSHEET_IMPORT
  RUN_DECK_SPREADSHEET_IMPORT_BATCH
  PARSE_EPUB
  TRANSLATE_BOOK_PAGES
}

enum WorkerJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ImportProcess {
  id                     String              @id @default(cuid())
  userId                 String
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 ImportProcessStatus @default(UPLOADED)
  filename               String
  fileSize               Int
  storagePath            String
  detectedCollectionFile String?
  deckName               String?
  defaultFrontLanguageId Int?
  defaultFrontLanguage   Language?           @relation("ImportProcessDefaultFrontLanguage", fields: [defaultFrontLanguageId], references: [id], onDelete: SetNull)
  defaultBackLanguageId  Int?
  defaultBackLanguage    Language?           @relation("ImportProcessDefaultBackLanguage", fields: [defaultBackLanguageId], references: [id], onDelete: SetNull)
  inverseReviewEnabled   Boolean?
  createdDeckId          String?
  rowCount               Int                 @default(0)
  selectedRowCount       Int                 @default(0)
  importedCardCount      Int                 @default(0)
  failedRowCount         Int                 @default(0)
  errorSummary           String?
  errorDetailsJson       String?
  completedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  cardTypes  ImportCardType[]
  workerJobs WorkerJob[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ImportCardType {
  id               String             @id @default(cuid())
  processId        String
  process          ImportProcess      @relation(fields: [processId], references: [id], onDelete: Cascade)
  modelKey         String
  modelName        String
  modelKind        ImportCardTypeKind
  rowCount         Int
  fieldNamesJson   String
  sampleRowsJson   String
  selected         Boolean            @default(false)
  subjectField     String?
  cardMappingsJson String?
  pluginsJson      String?
  previewCardsJson String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([processId, modelKey])
  @@index([processId])
}

model WorkerJob {
  id          String          @id @default(cuid())
  processId   String?
  process     ImportProcess?  @relation(fields: [processId], references: [id], onDelete: Cascade)
  bookId      String?
  book        Book?           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  type        WorkerJobType
  payloadJson String?
  status      WorkerJobStatus @default(PENDING)
  attempts    Int             @default(0)
  error       String?
  availableAt DateTime        @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([processId])
  @@index([bookId, type, status])
}

enum SpreadsheetImportStatus {
  UPLOADED
  IMPORTING
  SUCCEEDED
  FAILED
}

model SpreadsheetImport {
  id               String                  @id @default(cuid())
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId           String?
  deck             Deck?                   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  batchId          String?
  pendingDeckName  String?
  ignoreRowIds     Boolean                 @default(false)
  status           SpreadsheetImportStatus @default(UPLOADED)
  filename         String
  fileSize         Int
  storagePath      String
  workerJobId      String?
  rowCount         Int                     @default(0)
  createdCardCount Int                     @default(0)
  updatedCardCount Int                     @default(0)
  deletedCardCount Int                     @default(0)
  errorSummary     String?
  errorDetailsJson String?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([deckId, createdAt])
  @@index([status, createdAt])
  @@index([workerJobId])
  @@index([batchId])
}

model ReviewStat {
  id          String                 @id @default(cuid())
  deckId      String
  deck        Deck                   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  date        DateTime
  cardMinutes Int                    @default(0)
  cardCount   Int                    @default(0)
  uniqueCards ReviewStatUniqueCard[]

  @@unique([deckId, date])
  @@index([deckId, date])
}

model ReviewStatUniqueCard {
  id     String @id @default(cuid())
  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  cardId       String
  card         Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  reviewStat   ReviewStat? @relation(fields: [reviewStatId], references: [id])
  reviewStatId String?

  @@unique([deckId, cardId])
  @@index([deckId, cardId])
}

// ---------- books (epub reader) ----------

enum BookStatus {
  UPLOADED
  PARSING
  READY
  FAILED
}

enum BookTranslationStatus {
  PENDING
  TRANSLATING
  DONE
  FAILED
}

model Book {
  id     String @id @default(cuid())
  deckId String @unique
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title            String
  author           String?
  epubLanguage     String?
  sourceLanguageId Int?
  sourceLanguage   Language? @relation("BookSourceLanguage", fields: [sourceLanguageId], references: [id], onDelete: SetNull)
  targetLanguageId Int?
  targetLanguage   Language? @relation("BookTargetLanguage", fields: [targetLanguageId], references: [id], onDelete: SetNull)

  filename    String
  fileSize    Int
  storagePath String

  status            BookStatus @default(UPLOADED)
  // pageCount is the number of BookPage rows; currentPageIndex is where
  // "continue reading" resumes, furthestPageIndex drives overall progress.
  pageCount         Int        @default(0)
  currentPageIndex  Int        @default(0)
  furthestPageIndex Int        @default(0)
  lastReadAt        DateTime?
  errorSummary      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  chapters     BookChapter[]
  pages        BookPage[]
  bookmarks    BookBookmark[]
  readingStats BookReadingStat[]
  workerJobs   WorkerJob[]

  @@index([userId, createdAt])
}

model BookChapter {
  id             String     @id @default(cuid())
  bookId         String
  book           Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title          String
  order          Int
  startPageIndex Int
  pages          BookPage[]

  @@unique([bookId, order])
  @@index([bookId, startPageIndex])
}

model BookPage {
  id        String       @id @default(cuid())
  bookId    String
  book      Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  index     Int
  chapterId String?
  chapter   BookChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  markdown          String
  charCount         Int
  translation       String?
  translationStatus BookTranslationStatus @default(PENDING)
  translationError  String?

  @@unique([bookId, index])
  @@index([bookId, translationStatus])
}

model BookBookmark {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageIndex Int
  name      String
  createdAt DateTime @default(now())

  @@index([bookId, pageIndex])
}

model BookReadingStat {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  date      DateTime
  pagesRead Int      @default(0)

  @@unique([bookId, date])
  @@index([bookId, date])
}
